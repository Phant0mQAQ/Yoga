# Alibaba Cloud US (Silicon Valley / US West 1) production profile.
CLOUD_PROVIDER=alibaba
NODE_ENV=production
PORT=8080
APP_BASE_URL=https://api.example.com
APP_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=https://admin.example.com
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password
AUTH_PROVIDER=firebase
FIREBASE_WEB_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY

# ApsaraDB RDS for PostgreSQL. URL-encode special characters in the password.
DATABASE_URL=postgresql://good_vibe_app:ENCODED_PASSWORD@pgm-example.pg.rds.aliyuncs.com:5432/good_vibe
DATABASE_POOL_MAX=5
# Use verify-full with the RDS CA certificate in production. Use require only during initial connectivity testing.
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_BASE64=BASE64_ENCODED_RDS_CA_CERTIFICATE

# OSS in US West 1. Use a RAM user/role limited to this bucket and object prefix.
OSS_REGION=oss-us-west-1
OSS_ACCESS_KEY_ID=LTAI_REPLACE
OSS_ACCESS_KEY_SECRET=replace-with-ram-secret
OSS_BUCKET=good-vibe-media-us-west-1
OSS_PUBLIC_BASE_URL=https://assets.example.com

# Stripe remains the payment provider.
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_MERCHANT_IDENTIFIER=merchant.com.goodvibe.pilatesyoga

# Static admin site bucket/CDN deployment.
OSS_ADMIN_REGION=oss-us-west-1
OSS_ADMIN_BUCKET=good-vibe-admin-us-west-1
GOOD_VIBE_API_BASE_URL=https://api.example.com/api/v1

# EAS public production variables. These values are compiled into the app and are not secrets.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=merchant.com.goodvibe.pilatesyoga

# One-time migration source. Remove these values after cutover.
SUPABASE_SOURCE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SOURCE_SECRET_KEY=sb_secret_REPLACE
SUPABASE_SOURCE_STORAGE_BUCKET=good-vibe-public
