PORT=8080
APP_BASE_URL=http://localhost:8080
APP_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:8080
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password
LEGAL_OPERATOR_NAME=Good Vibe Pilates & Yoga LLC
LEGAL_POSTAL_ADDRESS=Your complete California business mailing address
PRIVACY_EMAIL=privacy@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
AUTH_PROVIDER=firebase
FIREBASE_WEB_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
# Server-side only. Share this fixed code only with approved coaches.
COACH_INVITE_CODE=REPLACE_WITH_A_STRONG_COACH_INVITE_CODE
# Development/test only. Never set console mode in production.
EMAIL_DELIVERY_MODE=console
LEGAL_EFFECTIVE_DATE=July 16, 2026

# Supabase project settings. Keep the service-role key on the API server only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY
# Optional in development, required for durable production admin uploads.
# Pre-create this bucket as public; signed upload URLs remain valid for 2 hours.
SUPABASE_STORAGE_BUCKET=good-vibe-public

# Legacy fallback only. Prefer SUPABASE_SECRET_KEY for new projects.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Stripe server-side settings.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MERCHANT_IDENTIFIER=merchant.com.goodvibe.pilatesyoga

# Deployment CLI values. Do not expose server secrets through EXPO_PUBLIC_*.
SUPABASE_ACCESS_TOKEN=
EXPO_TOKEN=
EXPO_PUBLIC_API_BASE_URL=https://YOUR_API_HOST/api/v1
GOOD_VIBE_API_BASE_URL=https://YOUR_API_HOST/api/v1
