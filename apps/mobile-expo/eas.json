{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://good-vibe-pilates-yoga.2316196563.workers.dev/api/v1"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://good-vibe-pilates-yoga.2316196563.workers.dev/api/v1"
      },
      "ios": {
        "simulator": false
      }
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://good-vibe-pilates-yoga.2316196563.workers.dev/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://good-vibe-pilates-yoga.2316196563.workers.dev/api/v1"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6792816984",
        "metadataPath": "./store.config.json"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6792816984",
        "metadataPath": "./store.config.json"
      }
    }
  }
}
