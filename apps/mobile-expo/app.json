{
  "expo": {
    "name": "Good Vibe Pilates & Yoga",
    "slug": "good-vibe-pilates-yoga",
    "scheme": "goodvibe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/good-vibe-icon.png",
    "splash": {
      "image": "./assets/good-vibe-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#AAA5A3"
    },
    "ios": {
      "icon": "./assets/good-vibe-icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.goodvibe.pilatesyoga",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera access is used by staff to scan booking check-in QR codes.",
        "NSPhotoLibraryUsageDescription": "Photo library access is used by members to choose a profile photo and by admins to upload coach, content, and product images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/good-vibe-adaptive-icon.png",
        "backgroundColor": "#AAA5A3"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is used by staff to scan booking check-in QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Good Vibe Pilates & Yoga to access your photos so you can choose a profile photo or upload studio images.",
          "microphonePermission": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.goodvibe.pilatesyoga",
          "enableGooglePay": true
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf7a295f-471a-4efb-9931-bed4b2236f7d"
      }
    },
    "owner": "yogayoga"
  }
}
